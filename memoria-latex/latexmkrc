# Configuración de compilación de la memoria.
# Uso: desde memoria-latex/, ejecutar `latexmk` (sin argumentos).

@default_files = ('__memoria.tex');
$pdf_mode = 1;                                   # pdflatex
$pdflatex = 'pdflatex -shell-escape -interaction=nonstopmode -synctex=1 %O %S';  # minted necesita -shell-escape

# Glosario y lista de acrónimos (paquete glossaries), igual que hace Overleaf
add_cus_dep('glo', 'gls', 0, 'run_makeglossaries');
add_cus_dep('acn', 'acr', 0, 'run_makeglossaries');
sub run_makeglossaries {
    my ($base_name, $path) = fileparse($_[0]);
    pushd $path;
    my $return = system "makeglossaries", $base_name;
    popd;
    return $return;
}
push @generated_exts, 'glo', 'gls', 'glg', 'acn', 'acr', 'alg', 'ist', 'loc', 'lol';
$clean_ext .= ' %R.ist %R.xdy';
